# ─── Obrigatórias ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres   # Supabase → Connect → Transaction pooler
SESSION_SECRET=                # 64 caracteres aleatórios (openssl rand -hex 32)
ADMIN_EMAIL=                   # e-mail do primeiro administrador (usado só se ainda não há usuários)
ADMIN_PASSWORD=                # senha inicial do admin (mín. 10 caracteres)
ADMIN_NAME=Administrador

# ─── Latitude (IA de texto/fotos + envio de imóveis) ──────────
LATITUDE_EMAIL=
LATITUDE_SENHA=
LATITUDE_EMPRESA_ID=45bdffcb-bb59-43a1-9edf-258c3aa5177e   # My Broker Uberlândia

# ─── Precificação por pesquisa na web (função principal) ──────
GEMINI_API_KEY=                # aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.5-flash
